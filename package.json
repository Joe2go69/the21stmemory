{
  "name": "21st-memory",
  "private": true,
  "scripts": {
    "build:css": "npx tailwindcss -i ./assets/css/tailwind.input.css -o ./assets/css/tailwind.css --minify",
    "split:css": "node scripts/split-main-css.js",
    "normalize:images": "node scripts/normalize-image-assets.js",
    "build:data": "node scripts/split-topics-data.js",
    "enrich:descriptions": "node scripts/enrich-topic-descriptions.js",
    "audit:images": "node scripts/audit-topic-images.js",
    "build:sitemap": "node scripts/generate-sitemap.js",
    "build:chrome": "node scripts/inline-chrome.js",
    "chrome": "npm run build:chrome",
    "build": "npm run build:data && npm run build:css && npm run build:chrome && npm run build:sitemap"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}